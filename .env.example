# Base compartida de los cinco productos (solo lectura desde acá).
DATABASE_URL=
# Mismo proyecto Supabase que el resto: la sesión es la misma.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Mercado Pago. En prueba las credenciales empiezan con TEST-.
MP_ACCESS_TOKEN=
NEXT_PUBLIC_MP_PUBLIC_KEY=
# La "Clave secreta" del webhook, del panel de Mercado Pago. Sin ella los avisos
# se aceptan igual (el detalle se busca en la API), pero con ella se descarta lo
# falsificado antes de gastar una consulta.
MP_WEBHOOK_SECRET=
