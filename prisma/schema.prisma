// Superadmin de soytu: LEE la base compartida de los cinco productos.
//
// Solo se declara lo que este panel mira. Es un subconjunto de `tenants`, la
// misma tabla que usan soytuadmin, soytucanje, soytuturno y soytubar — acá no se
// crea ni se migra nada, se consulta.
generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/soytu"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug            String   @unique
  name            String
  /// Qué productos usa: ['soytuadmin', 'soytucanje', 'soytuturno', 'soytubar'].
  enabledProducts String[] @map("enabled_products")
  active          Boolean  @default(true)
  email           String?
  phone           String?
  ownerEmail      String?  @map("owner_email")
  ownerName       String?  @map("owner_name")
  createdAt       DateTime @default(now()) @map("created_at")

  subscription Subscription?
  payments     SubscriptionPayment[]

  @@map("tenants")
}

/// Quién puede entrar acá. Es la MISMA tabla que usan los otros productos, así
/// que el superadmin de soytu es el mismo que ya existe, no uno nuevo.
/// Es un enum de Postgres, no texto: declararlo como String hace que Prisma
/// falle al leerlo ("incompatible value of SUPERADMIN").
enum AdminUserType {
  SUPERADMIN
  TENANT_ADMIN
}

model AdminUser {
  id             String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  supabaseUserId String  @unique @map("supabase_user_id") @db.Uuid
  email          String  @unique
  fullName       String? @map("full_name")
  /// Acá solo entra SUPERADMIN.
  type           AdminUserType
  active         Boolean @default(true)

  @@map("admin_users")
}

/// El estado de pago de un comercio. Ver `sql/01-suscripciones.sql`.
model Subscription {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String    @unique @map("tenant_id") @db.Uuid
  /// 'PRUEBA' | 'authorized' | 'paused' | 'cancelled' | 'VENCIDA'
  status          String    @default("PRUEBA")
  paidUntil       DateTime? @map("paid_until")
  amount          Decimal?  @db.Decimal(14, 2)
  currency        String    @default("ARS")
  billingPeriodId String?   @map("billing_period_id") @db.Uuid
  billingPeriod   BillingPeriod? @relation(fields: [billingPeriodId], references: [id])
  mpPreapprovalId String?   @unique @map("mp_preapproval_id")
  mpPayerEmail    String?   @map("mp_payer_email")
  lastEvent       Json?     @map("last_event")
  lastEventAt     DateTime? @map("last_event_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

/// Cada cobro. Aparte de la suscripcion porque hay uno por mes.
model SubscriptionPayment {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  mpPaymentId String?   @unique @map("mp_payment_id")
  status      String
  amount      Decimal?  @db.Decimal(14, 2)
  currency    String    @default("ARS")
  paidAt      DateTime? @map("paid_at")
  raw         Json?
  createdAt   DateTime  @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@map("subscription_payments")
}

/// Qué se vende. Ver `sql/02-productos-y-planes.sql`.
model BillingProduct {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Coincide con lo que guarda `tenants.enabled_products`.
  key         String   @unique
  name        String
  description String?
  active      Boolean  @default(true)
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  plans BillingPlan[]

  @@map("billing_products")
}

/// Cuánto trae. Un producto tiene varios planes segun las features.
model BillingPlan {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId   String   @map("product_id") @db.Uuid
  name        String
  description String?
  features    String[] @default([])
  active      Boolean  @default(true)
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  product BillingProduct  @relation(fields: [productId], references: [id], onDelete: Cascade)
  periods BillingPeriod[]

  @@unique([productId, name])
  @@map("billing_plans")
}

/// Cada cuanto y a cuanto. El precio vive aca porque cambia con la frecuencia.
model BillingPeriod {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  planId    String   @map("plan_id") @db.Uuid
  /// 'MENSUAL' | 'TRIMESTRAL' | 'SEMESTRAL' | 'ANUAL'
  period    String
  price     Decimal  @db.Decimal(14, 2)
  currency  String   @default("ARS")
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  plan          BillingPlan    @relation(fields: [planId], references: [id], onDelete: Cascade)
  subscriptions Subscription[]

  @@unique([planId, period])
  @@map("billing_periods")
}
